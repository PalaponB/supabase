# Copy this file to .env.local and fill in the values from your Supabase project:
# Dashboard > Project Settings > API
#
# These two are PUBLIC. The anon key is protected by Row Level Security, and the
# key you have already loaded into 01_schema.sql, 02_rls.sql and the seed files
# is exactly this anon key, so RLS is what actually guards your data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service_role key in a NEXT_PUBLIC_ variable.
# Anything prefixed with NEXT_PUBLIC_ is inlined into the client bundle and is
# readable by anyone who opens devtools. This project does not use it at all:
# every permission check is done with the anon key plus RLS, so there is no
# reason to have the service_role key anywhere in this app or in .env.local.
#
# If you ever need service_role access from a trusted server, use the
# unprefixed name SUPABASE_SERVICE_ROLE_KEY, keep it in .env.local only, and
# read it exclusively from server code. Never import it into a "use client"
# file or pass it to a client component as a prop.
